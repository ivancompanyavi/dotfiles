#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# theme-browser — align the browser's (Chromium) autogenerated theme with the
# active system theme.
#
# This file is a chezmoi TEMPLATE: the browser identity (app name + user-data
# dir) is baked in from .chezmoidata/apps.yaml (.apps.browser), so switching
# browsers is a one-file edit there — no changes needed in this script.
#
# Every profile in that user-data dir is themed, so a personal and a work
# profile both follow the active theme.
#
# Chromium reads browser.theme.* from the profile's Preferences only at launch
# and REWRITES that file from memory on exit. So a write only sticks while the
# browser is not running; editing a live browser is futile (it gets clobbered on
# quit). We therefore write only when it is closed, and the new chrome color
# shows on the next launch. Launching through `theme-browser open` (wired to
# the aerospace alt-b binding) guarantees the color is current every time.
#
# The seed is the theme's BACKGROUND, not its accent. Chromium derives a whole
# tonal palette from the seed rather than painting the chrome with it, so an
# accent seed gave a browser frame in some other colour entirely. Seeding with
# the background lands the frame on the theme background and the toolbar a step
# above it, which is how the theme's own bg/surface pair relates. Measured on
# catppuccin dark: frame #1d1e2f against a theme bg of #1e1e2e, toolbar #3a3a4c
# against a surface of #313244.
#
# Both the legacy (user_color/is_grayscale) and current (*2) pref names are
# written — Brave 147 ships both key names in its binary and this is what
# empirically held across a full launch in testing (unlike Helium, which
# forces is_grayscale2 back to true shortly after startup and never settles).
#
#   theme-browser apply    write the accent into Preferences if closed
#   theme-browser open     apply (while closed) then launch/focus the browser
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# Baked in from .chezmoidata/apps.yaml at `chezmoi apply` time.
APP_NAME={{ .apps.browser.appName | quote }}
USER_DATA_DIR={{ .apps.browser.userDataDir | quote }}

THEME_HOME="${THEME_HOME:-$HOME/.config/theme}"
RESOLVE="$THEME_HOME/lib/resolve.sh"
USER_DATA="$HOME/Library/Application Support/$USER_DATA_DIR"

browser_running() { pgrep -f "$APP_NAME.app/Contents/MacOS/$APP_NAME" >/dev/null 2>&1; }

# Every profile keeps its own theme in its own directory under the user-data
# dir: "Default", plus "Profile 1", "Profile 2" and so on. A personal and a
# work profile therefore both need writing.
profile_prefs() {
  local dir
  for dir in "$USER_DATA"/Default "$USER_DATA"/Profile\ *; do
    [ -f "$dir/Preferences" ] && echo "$dir/Preferences"
  done
}

write_prefs() {
  local seed prefs written=0
  seed="$(bash "$RESOLVE" role bg)"   # #rrggbb
  while IFS= read -r prefs; do
    [ -n "$prefs" ] || continue
    SEED="$seed" PREFS="$prefs" python3 - <<'PYTHON'
import json, os, tempfile
prefs  = os.environ['PREFS']
seed   = os.environ['SEED'].lstrip('#')
r, g, b = int(seed[0:2], 16), int(seed[2:4], 16), int(seed[4:6], 16)
argb   = (0xFF << 24) | (r << 16) | (g << 8) | b
signed = argb - (1 << 32) if argb >= (1 << 31) else argb  # SkColor is a signed int32
with open(prefs) as f:
    d = json.load(f)
theme = d.setdefault('browser', {}).setdefault('theme', {})
theme['user_color2']   = signed
theme['user_color']    = signed
theme['is_grayscale2'] = False
theme['is_grayscale']  = False
# 1 is the tonal-spot variant, the browser's own default. Writing it makes every
# profile render the same way instead of depending on what each one had.
theme['color_variant2'] = 1
# Mark the generated color as the active theme, the way the browser does when
# you pick a color in its settings. An installed extension theme is left alone:
# overwriting its id would point the profile at a theme that is not there.
ext = d.setdefault('extensions', {}).setdefault('theme', {})
if ext.get('id', '') in ('', 'user_color_theme_id'):
    ext['id'] = 'user_color_theme_id'
# Atomic replace so a crash mid-write can't corrupt the profile.
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(prefs))
with os.fdopen(fd, 'w') as f:
    json.dump(d, f, separators=(',', ':'))
os.replace(tmp, prefs)
print(f"theme-browser: seed #{seed} -> {os.path.basename(os.path.dirname(prefs))}")
PYTHON
    written=$((written + 1))
  done < <(profile_prefs)
  [ "$written" -gt 0 ] || echo "theme-browser: no $APP_NAME profile yet — skipping" >&2
}

case "${1:-apply}" in
  apply)
    if browser_running; then
      echo "theme-browser: $APP_NAME is open — new theme applies next launch (alt-b)"
    else
      write_prefs
    fi
    ;;
  open)
    browser_running || write_prefs
    open -a "$APP_NAME"
    ;;
  *)
    echo "usage: theme-browser [apply|open]" >&2
    exit 2
    ;;
esac
