-- ─────────────────────────────────────────────────────────────────────────────
-- Hyprland: the Linux counterpart of aerospace.toml. Same workspaces (1 terminal,
-- 2 browser, 3 editor, 4, 5, R catch-all) and the same bindings, with SUPER in
-- place of alt (same physical key on a PC keyboard). Apps come from
-- .chezmoidata/apps.yaml; colors from the theme system.
--
-- Modifier layers: SUPER = window manager, CTRL = apps, CTRL+SHIFT = terminal.
-- Wiki: https://wiki.hypr.land/Configuring/
-- ─────────────────────────────────────────────────────────────────────────────

local home       = os.getenv("HOME")
local theme_bin  = home .. "/.config/theme/bin"
local theme_state = (os.getenv("XDG_STATE_HOME") or (home .. "/.local/state")) .. "/theme"

local terminal    = {{ .apps.terminal.linux.exec | quote }}
local browser     = {{ .apps.browser.linux.exec | quote }}
local telegram    = {{ .apps.telegram.linux.exec | quote }}
local fileManager = "thunar"
local launcher    = "fuzzel"

local mainMod = "SUPER"


----------------
--- MONITORS ---
----------------

-- Samsung Odyssey G8: "preferred" picks 4K@60, so request 120Hz explicitly
hl.monitor({
    output   = "HDMI-A-1",
    mode     = "3840x2160@120",
    position = "0x0",
    scale    = 1,
})

-- Fallback for any other monitor
hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = "auto",
})


-----------------
--- AUTOSTART ---
-----------------

hl.on("hyprland.start", function()
    -- Portal and dunst/swaync can be D-Bus activated before the compositor exists
    -- and hit systemd's restart limit; clear that and restart the portal now.
    hl.exec_cmd("systemctl --user reset-failed xdg-desktop-portal-hyprland.service; systemctl --user restart xdg-desktop-portal-hyprland.service")
    hl.exec_cmd("/usr/lib/hyprpolkitagent/hyprpolkitagent")
    -- The theme system writes hyprpaper's config; generate it first on a fresh machine.
    hl.exec_cmd("[ -f " .. theme_state .. "/hyprpaper.conf ] || " .. theme_bin .. "/theme reapply; hyprpaper -c " .. theme_state .. "/hyprpaper.conf")
    hl.exec_cmd("waybar")
    hl.exec_cmd("swaync")
    hl.exec_cmd("wl-paste --watch cliphist store")
    hl.exec_cmd(terminal)
end)


-----------------------------
--- ENVIRONMENT VARIABLES ---
-----------------------------

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

-- NVIDIA (https://wiki.hypr.land/Nvidia/)
hl.env("LIBVA_DRIVER_NAME", "nvidia")          -- VA-API via libva-nvidia-driver
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")                -- libva-nvidia-driver backend
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto") -- run Electron apps natively on Wayland


---------------------
--- LOOK AND FEEL ---
---------------------

hl.config({
    general = {
        -- AeroSpace's external-monitor gaps. The top is 40 rather than 80
        -- because waybar reserves its own 40px, where sketchybar reserved none.
        gaps_in  = 22,
        gaps_out = { top = 40, right = 120, bottom = 80, left = 120 },
        border_size = 3,
        resize_on_border = false,
        allow_tearing = false,
        layout = "dwindle",
    },

    decoration = {
        -- Square corners: the Mac borders are only round because macOS forces it.
        rounding = 0,
        active_opacity   = 1.0,
        inactive_opacity = 1.0,
        shadow = { enabled = false },
        -- Frosted glass behind WezTerm's 0.9 opacity, like its macOS blur.
        blur = {
            enabled  = true,
            size     = 6,
            passes   = 2,
            vibrancy = 0.1696,
        },
    },

    animations = { enabled = true },

    dwindle = {
        preserve_split = true,
    },

    -- AeroSpace's accordion layout becomes a Hyprland group (tabbed windows).
    group = {
        groupbar = {
            font_family = "Fira Code",
            font_size = 12,
            height = 22,
            rounding = 0,
            gradients = false,
        },
    },

    binds = {
        workspace_back_and_forth = true,    -- AeroSpace's --auto-back-and-forth
        movefocus_cycles_groupfirst = true, -- SUPER+hjkl walks through a group's tabs first
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo   = true,
    },

    input = {
        kb_layout = "us",
        follow_mouse = 1,
        sensitivity = 0,
    },
})

-- Border colors from the active theme (regenerated by `theme reapply`).
local theme_colors = theme_state .. "/hyprland.lua"
if io.open(theme_colors, "r") then
    dofile(theme_colors)
end

hl.curve("easeOutQuint",   { type = "bezier", points = { {0.23, 1},    {0.32, 1}    } })
hl.curve("easeInOutCubic", { type = "bezier", points = { {0.65, 0.05}, {0.36, 1}    } })
hl.curve("linear",         { type = "bezier", points = { {0, 0},       {1, 1}       } })
hl.curve("almostLinear",   { type = "bezier", points = { {0.5, 0.5},   {0.75, 1}    } })
hl.curve("quick",          { type = "bezier", points = { {0.15, 0},    {0.1, 1}     } })
hl.curve("easy",           { type = "spring", mass = 1, stiffness = 238.1191, dampening = 24.21279333 })

hl.animation({ leaf = "global",        enabled = true,  speed = 10,   bezier = "default" })
hl.animation({ leaf = "border",        enabled = true,  speed = 5.39, bezier = "easeOutQuint" })
hl.animation({ leaf = "windows",       enabled = true,  speed = 4.79, spring = "easy" })
hl.animation({ leaf = "windowsIn",     enabled = true,  speed = 4.1,  spring = "easy",         style = "popin 87%" })
hl.animation({ leaf = "windowsOut",    enabled = true,  speed = 1.49, bezier = "linear",       style = "popin 87%" })
hl.animation({ leaf = "fadeIn",        enabled = true,  speed = 1.73, bezier = "almostLinear" })
hl.animation({ leaf = "fadeOut",       enabled = true,  speed = 1.46, bezier = "almostLinear" })
hl.animation({ leaf = "fade",          enabled = true,  speed = 3.03, bezier = "quick" })
hl.animation({ leaf = "layers",        enabled = true,  speed = 3.81, bezier = "easeOutQuint" })
hl.animation({ leaf = "layersIn",      enabled = true,  speed = 4,    bezier = "easeOutQuint", style = "fade" })
hl.animation({ leaf = "layersOut",     enabled = true,  speed = 1.5,  bezier = "linear",       style = "fade" })
hl.animation({ leaf = "fadeLayersIn",  enabled = true,  speed = 1.79, bezier = "almostLinear" })
hl.animation({ leaf = "fadeLayersOut", enabled = true,  speed = 1.39, bezier = "almostLinear" })
