hl.animation({ leaf = "workspacesIn",  enabled = true,  speed = 1.21, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "workspacesOut", enabled = true,  speed = 1.94, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "zoomFactor",    enabled = true,  speed = 7,    bezier = "quick" })


------------------
--- WORKSPACES ---
------------------

-- Telegram lives in a dropdown (special workspace) and starts on first toggle.
hl.workspace_rule({ workspace = "special:telegram", on_created_empty = telegram })


--------------------
--- WINDOW RULES ---
--------------------

-- AeroSpace's on-window-detected. Like there, rules only apply to windows as
-- they open; already-open windows stay where they are.
local routes = {
    { class = {{ .apps.terminal.linux.class | quote }}, workspace = "1" },
    { class = {{ .apps.browser.linux.class | quote }},  workspace = "2" },
    { class = {{ .apps.telegram.linux.class | quote }}, workspace = "special:telegram" },
}

local routed = {}
for _, r in ipairs(routes) do
    local pattern = "^" .. r.class:gsub("%.", "\\.") .. "$"
    table.insert(routed, pattern)
    hl.window_rule({ match = { class = pattern }, workspace = r.workspace })
end

-- Theme picker (SUPER+SHIFT+T): a WezTerm window with its own class, floating.
hl.window_rule({
    match  = { class = "^theme-picker$" },
    float  = true,
    center = true,
    size   = { 900, 500 },
})

-- Utility windows float, like Finder / Calculator / Archive Utility on the Mac.
hl.window_rule({ match = { class = "^(thunar|xdg-desktop-portal-gtk|com\\.gabm\\.satty)$" }, float = true, center = true })

-- Catch-all: everything not routed above lands on workspace R.
table.insert(routed, "^theme-picker$")
table.insert(routed, "^(thunar|xdg-desktop-portal-gtk|com\\.gabm\\.satty)$")
hl.window_rule({
    match     = { class = "negative:(" .. table.concat(routed, "|") .. ")", float = false },
    workspace = "name:R",
})

-- Ignore maximize requests from apps; the layout decides sizes.
hl.window_rule({
    name  = "suppress-maximize-events",
    match = { class = ".*" },
    suppress_event = "maximize",
})

-- Fix some dragging issues with XWayland
hl.window_rule({
    name  = "fix-xwayland-drags",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },
    no_focus = true,
})


-------------------
--- KEYBINDINGS ---
-------------------

-- Apps (aerospace: alt-enter / alt-b / alt-t)
hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + B",      hl.dsp.exec_cmd(browser))
hl.bind(mainMod .. " + T",      hl.dsp.workspace.toggle_special("telegram"))
hl.bind(mainMod .. " + E",      hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + Space",  hl.dsp.exec_cmd(launcher))

-- Theme (aerospace: alt-shift-t picker, alt-d light/dark)
hl.bind(mainMod .. " + SHIFT + T", hl.dsp.exec_cmd(terminal .. " start --class theme-picker -- " .. theme_bin .. "/theme-picker"))
hl.bind(mainMod .. " + D",         hl.dsp.exec_cmd("darkman toggle"))

-- Join the current/next meeting (aerospace: alt-m)
hl.bind(mainMod .. " + M", hl.dsp.exec_cmd(home .. "/.config/waybar/scripts/open-next-meeting.sh"))

-- Layouts (aerospace: alt-slash tiles, alt-comma accordion, alt-period floating)
hl.bind(mainMod .. " + slash",  hl.dsp.layout("togglesplit"))
hl.bind(mainMod .. " + comma",  hl.dsp.group.toggle())
hl.bind(mainMod .. " + period", hl.dsp.window.float({ action = "toggle" }))

-- Focus and move
hl.bind(mainMod .. " + H", hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + J", hl.dsp.focus({ direction = "down" }))
hl.bind(mainMod .. " + K", hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + L", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + SHIFT + H", hl.dsp.window.move({ direction = "left" }))
hl.bind(mainMod .. " + SHIFT + J", hl.dsp.window.move({ direction = "down" }))
hl.bind(mainMod .. " + SHIFT + K", hl.dsp.window.move({ direction = "up" }))
hl.bind(mainMod .. " + SHIFT + L", hl.dsp.window.move({ direction = "right" }))

-- Resize (aerospace: resize smart -50 / +50)
hl.bind(mainMod .. " + minus", hl.dsp.window.resize({ x = -50, y = 0, relative = true }), { repeating = true })
hl.bind(mainMod .. " + equal", hl.dsp.window.resize({ x = 50, y = 0, relative = true }),  { repeating = true })

-- Workspaces (a second press on the current one goes back, via binds config)
for _, ws in ipairs({ "1", "2", "3", "4", "5", "R" }) do
    local target = (ws == "R") and "name:R" or ws
    hl.bind(mainMod .. " + " .. ws,         hl.dsp.focus({ workspace = target }))
    hl.bind(mainMod .. " + SHIFT + " .. ws, hl.dsp.window.move({ workspace = target, follow = true }))
end
hl.bind(mainMod .. " + Tab",         hl.dsp.focus({ workspace = "previous" }))
hl.bind(mainMod .. " + SHIFT + Tab", hl.dsp.workspace.move({ monitor = "+1" }))

-- Windows
hl.bind(mainMod .. " + F",         hl.dsp.window.fullscreen())
hl.bind(mainMod .. " + SHIFT + Q", hl.dsp.window.close())
hl.bind(mainMod .. " + S",         hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }))
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Desktop tools
local screenshot_dir = home .. "/Pictures/Screenshots"
local satty = "satty --filename - --copy-command wl-copy --output-filename " .. screenshot_dir .. "/$(date +%Y-%m-%d_%H-%M-%S).png"
hl.bind("Print",                    hl.dsp.exec_cmd("mkdir -p " .. screenshot_dir .. " && grim -g \"$(slurp)\" - | " .. satty))
hl.bind(mainMod .. " + P",          hl.dsp.exec_cmd("mkdir -p " .. screenshot_dir .. " && grim -g \"$(slurp)\" - | " .. satty))
hl.bind("SHIFT + Print",            hl.dsp.exec_cmd("mkdir -p " .. screenshot_dir .. " && grim - | " .. satty))
hl.bind(mainMod .. " + SHIFT + P",  hl.dsp.exec_cmd("mkdir -p " .. screenshot_dir .. " && grim - | " .. satty))
hl.bind(mainMod .. " + SHIFT + V",  hl.dsp.exec_cmd("cliphist list | fuzzel --dmenu --prompt 'clip ❯ ' | cliphist decode | wl-copy"))
hl.bind(mainMod .. " + SHIFT + C",  hl.dsp.exec_cmd("hyprpicker --autocopy"))
hl.bind(mainMod .. " + N",          hl.dsp.exec_cmd("swaync-client --toggle-panel --skip-wait"))
hl.bind(mainMod .. " + SHIFT + E",  hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"))

-- Media keys
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
hl.bind("XF86AudioMute",        hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true })
hl.bind("XF86AudioMicMute",     hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   { locked = true })
hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })


--------------------
--- SERVICE MODE ---
--------------------

-- aerospace: alt-semicolon enters service mode; most keys act once and leave.
hl.bind(mainMod .. " + semicolon", hl.dsp.submap("service"))

hl.define_submap("service", function()
    local function once(dispatcher)
        return function()
            hl.dispatch(dispatcher)
            hl.dispatch(hl.dsp.submap("reset"))
        end
    end

    hl.bind("escape", once(hl.dsp.exec_cmd("hyprctl reload")))
    hl.bind("F",      once(hl.dsp.window.float({ action = "toggle" })))

    -- Close every other window on this workspace.
    hl.bind("BackSpace", function()
        local active = hl.get_active_window()
        if active and active.workspace then
            for _, w in ipairs(hl.get_workspace_windows(active.workspace.id)) do
                if w.address ~= active.address then
                    hl.dispatch(hl.dsp.window.close({ window = "address:" .. w.address }))
                end
            end
        end
        hl.dispatch(hl.dsp.submap("reset"))
    end)

    -- join-with: pull the neighbour into a group (tabs) with this window
    hl.bind(mainMod .. " + SHIFT + H", once(hl.dsp.window.move({ into_or_create_group = "left" })))
    hl.bind(mainMod .. " + SHIFT + J", once(hl.dsp.window.move({ into_or_create_group = "down" })))
    hl.bind(mainMod .. " + SHIFT + K", once(hl.dsp.window.move({ into_or_create_group = "up" })))
    hl.bind(mainMod .. " + SHIFT + L", once(hl.dsp.window.move({ into_or_create_group = "right" })))

    hl.bind("down",         hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { repeating = true })
    hl.bind("up",           hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { repeating = true })
    hl.bind("SHIFT + down", once(hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 0")))
end)
